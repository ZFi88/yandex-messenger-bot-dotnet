<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.AspNetCore.Http"/>
        <PackageReference Include="Microsoft.Extensions.Configuration"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Yandex.Messenger.Bot.Sdk\Yandex.Messenger.Bot.Sdk.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageId>Yandex.Messenger.Bot.AspNetCore</PackageId>
        <PackageReleaseNotes>Breaking changes: none. New: observer registrations (global, by text, by button, typed IObserver); DI bindings for the new IBot and IMessages clients; webhook middleware hardening (batch and single payloads, serialization fallback, error logging).</PackageReleaseNotes>
        <Description>ASP.NET integration library for Yandex Messenger bots API.</Description>
    </PropertyGroup>

</Project>
